# Copy to `.env.local` and fill in values from Firebase Console → Project settings → Your apps.
# Vite loads `.env.local` for local dev — NOT this file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional
VITE_FIREBASE_APP_ENV=staging
VITE_FIREBASE_WAITLIST_COLLECTION=waitlist

# MiWill App database (client wills). Falls back to VITE_FIREBASE_* when omitted.
VITE_MIWILL_APP_API_KEY=
VITE_MIWILL_APP_AUTH_DOMAIN=
VITE_MIWILL_APP_PROJECT_ID=
VITE_MIWILL_APP_STORAGE_BUCKET=
VITE_MIWILL_APP_MESSAGING_SENDER_ID=
VITE_MIWILL_APP_APP_ID=

# Optional: read-only MiWill App account for local dev when portal uses a different Firebase project
VITE_MIWILL_APP_READER_EMAIL=
VITE_MIWILL_APP_READER_PASSWORD=

# Optional: auto-fill password for the demo login account (email is loaded from the database).
VITE_DEMO_LOGIN_PASSWORD=

# Role PINs for portal login (4 digits each — never commit real values to git)
VITE_ADMIN_PIN=
VITE_AGENT_PIN=
